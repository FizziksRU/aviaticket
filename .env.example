# --- Telegram: токен от @BotFather и ваш числовой id (узнать у @userinfobot)
TG_BOT_TOKEN=
TG_ALLOWED_IDS=

# --- Travelpayouts (бесплатно): токен из кабинета, раздел API; marker это ваш партнёрский id
TP_TOKEN=
TP_MARKER=

# --- Playwright: 0 чтобы видеть окно браузера при отладке
HEADLESS=1
TOP_N=5

# --- LLM нужен только сайтам с use_llm: true в config/sites.yaml (по умолчанию не используется)
# gemini_local: локальный gemini CLI; agy_ssh: аккаунт пула на VPS через SSH (см. README)
LLM_BACKEND=gemini_local
GEMINI_CMD=gemini
GEMINI_MODEL=
GEMINI_TIMEOUT=180
AGY_SSH_HOST=
AGY_SSH_KEY=
AGY_ACCOUNT=acc4
AGY_PROXY=

# --- Очередь и ограничители (по умолчанию поведение как раньше)
# пауза между стартами сбора одного сайта, сек; кеш одинаковых запросов, сек
GUARD_MIN_INTERVAL=30
GUARD_CACHE_TTL=300
# сколько сборов одного сайта может идти одновременно (на разных телефонах)
GUARD_SITE_CONCURRENCY=1
# сколько сайтов один поиск собирает параллельно
SITES_PER_SEARCH=2
# 1: фоновый опрос подписок пропускает живых пользователей вперёд
SEARCH_PRIORITY=0
# 1: показывать «Вы N-й в очереди, примерно M мин»
QUEUE_NOTICE=0
