# --- Telegram: токен от @BotFather и ваш числовой id (узнать у @userinfobot)
TG_BOT_TOKEN=
TG_ALLOWED_IDS=

# --- Travelpayouts (бесплатно): токен из кабинета, раздел API; marker это ваш партнёрский id
TP_TOKEN=
TP_MARKER=

# --- Playwright: 0 чтобы видеть окно браузера при отладке
HEADLESS=1
TOP_N=5

# --- LLM нужен только сайтам с use_llm: true в config/sites.yaml (по умолчанию не используется)
# gemini_local: локальный gemini CLI; agy_ssh: аккаунт пула на VPS через SSH (см. README)
LLM_BACKEND=gemini_local
GEMINI_CMD=gemini
GEMINI_MODEL=
GEMINI_TIMEOUT=180
AGY_SSH_HOST=
AGY_SSH_KEY=
AGY_ACCOUNT=acc4
AGY_PROXY=

# --- Маршрутизация по телефонам (по умолчанию как в config/sites.yaml)
# сайт=телефон[,телефон] через «;» — переопределяет phone из sites.yaml.
# Замеры (docs/audit/02_droidhub.md): ozon не работает на realme, aviasales и onetwotrip — на redmi.
# PHONE_MAP=ozon_travel=redmi;aviasales=realme;onetwotrip=realme;yandex_travel=realme;kupibilet=redmi;tutu=redmi
PHONE_MAP=
# 1: повтор пустой выдачи идёт на другой телефон пула, а не на тот же
RETRY_OTHER_PHONE=0
