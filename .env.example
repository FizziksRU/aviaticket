# --- Telegram: токен от @BotFather и ваш числовой id (узнать у @userinfobot)
TG_BOT_TOKEN=
TG_ALLOWED_IDS=

# --- Travelpayouts (бесплатно): токен из кабинета, раздел API; marker это ваш партнёрский id
TP_TOKEN=
TP_MARKER=

# --- Playwright: 0 чтобы видеть окно браузера при отладке
HEADLESS=1
TOP_N=5

# --- LLM нужен только сайтам с use_llm: true в config/sites.yaml (по умолчанию не используется)
# gemini_local: локальный gemini CLI; agy_ssh: аккаунт пула на VPS через SSH (см. README)
LLM_BACKEND=gemini_local
GEMINI_CMD=gemini
GEMINI_MODEL=
GEMINI_TIMEOUT=180
AGY_SSH_HOST=
AGY_SSH_KEY=
AGY_ACCOUNT=acc4
AGY_PROXY=

# --- Наблюдаемость: /status для админов работает всегда
# 1: писать админам (TG_ALLOWED_IDS), когда сайт 3 сбора подряд не дал результата
HEALTH_ALERTS=0
