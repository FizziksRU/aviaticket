: 9623558, "to": 9600369, "aviaCompany": 60780, "companyTariff": 369, "departure": {"local": "2026-12-17T07:00:00", "offset": 180, "tzname": "Europe/Moscow"}, "arrival": {"local": "2026-12-17T09:20:00", "offset": 240, "tzname": "Asia/Yerevan"}, "tModel": null, "url": "https://travel.yandex.ru/avia/flights/A4-6029/?when=2026-12-17", "operating": {"company": 60780, "number": "A4 None"}}, {"key": "2612221810A460282612221830", "number": "A4 6028", "company": 60780, "from": 9600369, "to": 9623558, "aviaCompany": 60780, "companyTariff": 369, "departure": {"local": "2026-12-22T18:10:00", "offset": 240, "tzname": "Asia/Yerevan"}, "arrival": {"local": "2026-12-22T18:30:00", "offset": 180, "tzname": "Europe/Moscow"}, "tModel": null, "url": "https://travel.yandex.ru/avia/flights/A4-6028/?when=2026-12-22", "operating": {"company": 60780, "number": "A4 None"}}, {"key": "2612161440FV69492612161730", "number": "FV 6949", "company": 8565, "from": 9600380, "to": 9600369, "aviaCompany": 8565, "companyTariff": 475, "departure": {"local": "2026-12-16T14:40:00", "offset": 240, "tzname": "Europe/Samara"}, "arrival": {"local": "2026-12-16T17:30:00", "offset": 240, "tzname": "Asia/Yerevan"}, "tModel": null, "url": "https://travel.yandex.ru/avia/flights/FV-6949/?when=2026-12-16", "operating": {"company": 8565, "number": "FV None"}}, {"key": "26121610153F33842612161330", "number": "3F 3384", "company": 1089, "from": 9600380, "to": 9600369, "aviaCompany": 1089, "companyTariff": 860, "departure": {"local": "2026-12-16T10:15:00", "offset": 240, "tzname": "Europe/Samara"}, "arrival": {"local": "2026-12-16T13:30:00", "offset": 240, "tzname": "Asia/Yerevan"}, "tModel": null, "url": "https://travel.yandex.ru/avia/flights/3F-3384/?when=2026-12-16", "operating": null}], "alliances": [{"id": 1, "title": "Star Alliance"}, {"id": 2, "title": "SkyTeam"}, {"id": 3, "title": "Oneworld"}], "aviaCompanies": [{"id": 1089, "costType": "hybrid", "carryonWidth": null, "carryonHeight": null, "carryonLength": null, "baggageRules": "", "baggageRulesUrl": "", "baggageDimensionsSum": null, "carryonSizeBucket": "unknown"}, {"id": 7, "costType": "hybrid", "carryonWidth": 40, "carryonHeight": 25, "carryonLength": 55, "baggageRules": "Пассажиры бизнес-класса имеют право взять в салон два места ручной клади до 10 кг каждое, а пассажиры эконом-класса — одно место ручной клади до 10 кг. Норма провоза ручной клади для младенцев до 2 лет — одно место ручной клади до 10 кг, даже если ребёнок не занимает отдельное место в салоне. Помимо ручной клади пассажир может взять с собой сумку, рюкзак или чехол с техникой весом до 5 кг и размером до 40×30×10 см, а также документы, верхнюю одежду или костюм, зонтик или трость, букет, прессу для чтения в полёте и запечатанный пакет из Duty Free.", "baggageRulesUrl": "http://belavia.by/passengers/baggage/", "baggageDimensionsSum": 158, "carryonSizeBucket": "regular"}, {"id": 680, "costType": "hybrid", "carryonWidth": 40, "carryonHeight": 23, "carryonLength": 55, "baggageRules": "Правила могут отличаться в зависимости от пункта вылета и прилёта. Чтобы узнать, сколько багажа вы можете взять с собой, используйте калькулятор расчёта нормы провоза багажа на сайте авиакомпании. Вся ручная кладь пассажира должна свободно помещаться на полках для багажа или под сидением. Дополнительно пассажир может взять с собой фотоаппарат, ноутбук или планшет, складную коляску, а также зонтик, если его конец не заострён. В салоне разрешено перевозить косметику, пену для бритья и зубную пасту в ёмкостях объёмом до 100 миллилитров. В самолёт можно взять питание для ребёнка и лекарства, если это необходимо. В ручной клади запрещено перевозить игрушечное оружие и зажигалки в форме пистолета. Авиакомпания не принимает в багаж чемоданы тяжелее 32 кг.", "baggageRulesUrl": "https://www.turkishairlines.com/ru-int/any-questions/baggage-information/index.html", "baggageDimensionsSum": 158, "carryonSizeBucket": "regular"}, {"id": 60780, "costType": "hybrid", "carryonWidth": 40, "carryonHeight": 20, "carryonLength": 55, "baggageRules": "Допустимый вес ручной клади отличается в зависимости от тарифа: 5 или 10 кг. Габариты одного места ручной клади едины — 55 × 40 × 20 см. Но есть вещи, которые можно взять в салон без оглядки на эти цифры: рюкзак, дамскую сумку, портфель, ноутбук в чехле, букет цветов или верхнюю одежду. На эти предметы действуют свои ограничения по размеру и весу — нельзя, чтобы ваш рюкзак весил больше 5 кг. Ещё в салон можно взять костюм в портпледе, детское питание, коляску или люльку, если путешествуете с ребёнком, трости и костыли, если пассажир не может передвигаться без них, товары из дьюти-фри в опломбированном пластиковом пакете. Если берёте в салон зубную пасту, духи, гели, спреи, суп, воду или сироп, упакуйте каждую жидкость в отдельную ёмкость и закройте все эти вещи в одном прозрачном пластиковом пакете с молнией. Суммарный объём не должен превышать 100 мл. Можно перевозить даже ртутные градусники, термометры и одноразовые зажигалки, но не более одного предмета на пассажира. Полные правила указаны на сайте авиакомпании.", "baggageRulesUrl": "https://azimuth.aero/ru/passengers/baggage", "baggageDimensionsSum": 203, "carryonSizeBucket": "regular"}, {"id": 845, "costType": "hybrid", "carryonWidth": 40, "carryonHeight": 20, "carryonLength": 55, "baggageRules": "Провоз багажа может быть платным. Уточните стоимость при покупке билета.\r\nВ салон можно взять ручную кладь: сумку, рюкзак или небольшой чемодан. Ограничения по размеру и весу ручной клади можно посмотреть на сайте авиакомпании. Кроме того, в правилах авиакомпании перечислены предметы, которые тоже могут лететь в салоне. Это одна дамская сумочка или портфель, один плащ, накидка, платок или одеяло, один пакет магазина duty free, один зонт (за исключением зонтов с острым концом) или трость, детская люлька или прогулочная коляска, одна небольшая камера или телескоп, книги и журналы для чтения в полёте, складное кресло-коляска или пара костылей, детское питание и люлька для использования в полёте, один портативный компьютер.\r\nДетская колыбель, коляска и костыли обычно летят в багажном отделении, однако их не нужно сдавать при регистрации на рейс. Они остаются с пассажиром до входа в самолёт.\r\nПеред вылетом обязательно сверьтесь с правилами авиакомпании на её сайте — особенно если у вас с собой много разных вещей.", "baggageRulesUrl": "http://www.flypgs.com/ru/information/general-rules.aspx", "baggageDimensionsSum": null, "carryonSizeBucket": "regular"}, {"id": 8565, "costType": "hybrid", "carryonWidth": 40, "carryonHeight": 20, "carryonLength": 55, "baggageRules": "Норма провоза багажа и ручной клади зависит от нумерации рейса, тарифа и класса обслуживания. На рейсах SU 6001-6999 считают количество сумок, а на FV5501-5949 багаж и ручную кладь взвешивают. Без дополнительной платы на борт можно взять рюкзак или сумку с вещами, букет цветов, костюм, верхнюю одежду, питание и переноску для ребёнка, лекарственные средства и медицинские устройства, которые нужны пассажиру на время полёта, товары из Duty Free в запечатанном пластиковом пакете с чеком.", "baggageRulesUrl": "https://www.rossiya-airlines.com/flight-with-us/category_passenger/your_baggage/", "baggageDimensionsSum": 203, "carryonSizeBucket": "regular"}, {"id": 1111, "costType": "hybrid", "carryonWidth": 40, "carryonHeight": 25, "carryonLength": 50, "baggageRules": "На борт так же бесплатно можно взять одну ручную сумку/ноутбук в сумке, или пакет с товарами из DutyFree размерами не более 40 х 30 х 15 см.", "baggageRulesUrl": "http://www.etihad.com/en-us/before-you-fly/baggage-information/allowances/", "baggageDimensionsSum": 158, "carryonSizeBucket": "regular"}, {"id": 23, "costType": "hybrid", "carryonWidth": 40, "carryonHeight": 23, "carryonLength": 55, "baggageRules": "Для эконом-класса разрешается ручная кладь до 10 кг, для бизнес-класса — до 15 кг. Дополнительно можно взять сумку или рюкзак до 5 кг размером не больше 75 см в сумме трёх измерений, ноутбук или другую технику, верхнюю одежду, костюм в чехле, букет цветов, деньги и документы, нужные во время полёта лекарства, диетическое питание, складную коляску, костыли или трость. Разрешается провозить товары из Duty Free в запечатанном пакете не тяжелее 3 кг и не больше 75 см в сумме длины, ширины и высоты. Требования к багажу зависят от билета, уточняйте у оператора.", "baggageRulesUrl": "http://www.s7.ru/home/info/baggage.dot", "baggageDimensionsSum": 203, "carryonSizeBucket": "regular"}, {"id": 9144, "costType": "hybrid", "carryonWidth": 30, "carryonHeight": 27, "carryonLength": 36, "baggageRules": "В качестве ручной клади можно взять с собой любое количество вещей, главное, чтобы общий размер был не больше 36×30×27 см. Другой вариант — ручная кладь должна весить до 10 кг, а максимальные габариты составляли 36×30×4 см. Дополнительно авиакомпания разрешает бесплатно взять на борт ноутбук или планшет без чехла, зонт-трость, сумку или рюкзак с размерами до 36×30×23 см, букет, верхнюю одежду, костюм в портпледе, необходимые лекарства, костыли, трость или кресло-коляску, детское питание и устройство для переноса ребёнка. Также можно провезти товары из магазинов Duty Free в пакете размером 10×10×5 см. Нормы багажа зависят от тарифа, уточните на сайте компании.", "baggageRulesUrl": "https://www.pobeda.aero/information/travel/transport_regulations#baggage", "baggageDimensionsSum": 203, "carryonSizeBucket": "small"}, {"id": 26, "costType": "hybrid", "carryonWidth": 40, "carryonHeight": 25, "carryonLength": 55, "baggageRules": "В классах «Эконом» и «Комфорт» можно провезти не более 10 кг ручной клади. В классе «Бизнес» — до 15 кг. Дополнительно в салон разрешается взять сумку или рюкзак с вещами весом не больше 5 кг и размером 80 см по трём измерениям, один пакет из Duty Free не больше 115 см, верхнюю одежду, костюм в специальном чехле, букет, питание для ребёнка во время полёта, устройство для переноса ребёнка, складное кресло-коляску, костыли, трости, необходимые лекарства и диетическое питание. Условия провоза багажа уточняйте у оператора, например, в тарифе «Лайт» за багаж придётся платить.", "baggageRulesUrl": "http://www.aeroflot.ru/ru-ru/information/preparation/baggage", "baggageDimensionsSum": 158, "carryonSizeBucket": "regular"}, {"id": 29, "costType": "hybrid", "carryonWidth": 30, "carryonHeight": 20, "carryonLength": 40, "baggageRules": "В тарифах «Премиум» и «Бизнес» вместе с основной ручной кладью можно взять дополнительную размером 55×40×25 см и весом до 10 кг. Помимо этого, пассажир имеет право бесплатно провезти в салоне рюкзак или дамскую сумку размером 40×30×20 см не больше 5 кг, зонт-трость, питание для ребёнка, верхнюю одежду, костюм, люльку или коляску для ребёнка, лекарства и диетическое питание, пластиковый пакет с товарами из Duty Free не более 3 кг. Во всех тарифах, кроме «Минимума», бесплатно есть одно багажное место до 20 кг. А в тарифе «Премиум» можно провезти спортснаряжение. Другие ограничения по багажу и ручной клади уточняйте на сайте.", "baggageRulesUrl": "", "baggageDimensionsSum": null, "carryonSizeBucket": "small"}, {"id": 30, "costType": "hybrid", "carryonWidth": 40, "carryonHeight": 20, "carryonLength": 55, "baggageRules": "Для всех тарифов, кроме бизнес-класса, в качестве ручной клади предусмотрено 1 место весом до 10 кг. Бесплатно в самолёте можно провезти сумку или рюкзак, ноутбук и другую хрупкую технику, букет цветов, костюм, детское питание и игрушки, необходимые на время полёта лекарства и медицинские устройства, безопасную бритву, зажигалку, запечатанный пакет с покупками из Duty Free не больше 115 см. В тарифе «Промо лайт» не предусмотрен бесплатный багаж, остальные нормы уточняйте на сайте.", "baggageRulesUrl": "https://www.uralairlines.ru/rules/provoz-bagazha/", "baggageDimensionsSum": 203, "carryonSizeBucket": "regular"}, {"id": 351, "costType": "hybrid", "carryonWidth": 40, "carryonHeight": 20, "carryonLength": 55, "baggageRules": "Пассажиры с младенцами до двух лет могут взять в салон две сумки